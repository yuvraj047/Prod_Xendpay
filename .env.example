# Copy this file to ".env" and fill in your real EmailJS values.
# See EMAIL-SETUP.md for the full walkthrough (buying the GoDaddy business
# email, connecting it to EmailJS, and getting these three IDs).
#
# .env is already git-ignored, so your real keys never get committed or
# uploaded — only this .env.example template does.

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
